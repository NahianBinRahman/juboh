datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model SiteSetting {
  id                  String   @id @default(cuid())
  companyName         String   @default("JUBOH Companies International")
  shortName           String   @default("JUBOH")
  tagline             String   @default("BUILDING AN EXCEPTIONAL FUTURE, TOGETHER!")
  displayTagline      String   @default("Building an Exceptional Future, Together.")
  corporateDescriptor String   @db.Text
  inquiryEmail        String   @default("inquiries@juboh.com")
  operatingHubs       String   @default("United States & Select International Markets")
  updatedAt           DateTime @updatedAt
  createdAt           DateTime @default(now())
}

model BusinessArea {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  tagline      String
  summary      String   @db.Text
  description  String[] 
  capabilities String[]
  clientTypes  String[]
  image        String
  heroImage    String?
  displayOrder Int      @default(0)
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([slug])
}

model Project {
  id             String    @id @default(cuid())
  slug           String    @unique
  title          String
  discipline     String
  disciplineSlug String
  role           String
  location       String
  status         String
  summary        String    @db.Text
  overview       String[]
  highlights     String[]
  specifications Json      @default("{}")
  coverImage     String
  gallery        String[]
  displayOrder   Int       @default(0)
  isPublished    Boolean   @default(true)
  isVerified     Boolean   @default(false)
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([slug])
  @@index([disciplineSlug])
}

model Leader {
  id                 String   @id @default(cuid())
  slug               String   @unique
  fullName           String?
  title              String
  department         String
  quote              String   @db.Text
  portrait           String
  bio                String[]
  responsibilities   String[]
  displayOrder       Int      @default(0)
  isPublished        Boolean  @default(true)
  isIdentityVerified Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([slug])
}

model Article {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  category    String
  date        String
  readTime    String   @default("4 min read")
  excerpt     String   @db.Text
  lead        String   @db.Text
  body        String[]
  coverImage  String?
  tags        String[]
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@index([category])
}

model FoundationProgram {
  id          String   @id @default(cuid())
  title       String
  pillar      String
  description String   @db.Text
  initiatives String[]
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MediaAsset {
  id         String   @id @default(cuid())
  name       String
  url        String
  altText    String
  credit     String?
  focalPoint String   @default("center")
  width      Int?
  height     Int?
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  RESOLVED
}

model Inquiry {
  id           String        @id @default(cuid())
  fullName     String
  email        String
  organization String?
  inquiryType  String
  message      String        @db.Text
  status       InquiryStatus @default(NEW)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
}

enum AdminRole {
  SUPER_ADMIN
  EDITOR
}

model AdminUser {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  role         AdminRole  @default(SUPER_ADMIN)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([email])
}
